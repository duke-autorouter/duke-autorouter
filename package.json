{
  "name": "duke-autorouter",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Joshua Bloodworth",
  "homepage": "https://github.com/duke-autorouter/duke-autorouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duke-autorouter/duke-autorouter.git"
  },
  "bugs": {
    "url": "https://github.com/duke-autorouter/duke-autorouter/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "dev:ios-fixture": "node --import tsx scripts/ios-companion-fixture.ts",
    "dev:ios-private-beta": "DUKE_FIXTURE_TAILSCALE=1 node --import tsx scripts/ios-companion-fixture.ts",
    "start": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/build-document-tools.ts",
    "package:mac": "npm run build && node --import tsx scripts/package-macos.ts",
    "brand:icons": "node --import tsx scripts/build-brand-icons.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:importer": "node --import tsx scripts/importer-browser-check.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "eval": "node --import tsx scripts/evaluate.ts",
    "protocol": "codex app-server generate-ts --experimental --out server/generated/codex",
    "test:sandbox": "node --import tsx scripts/sandbox-check.ts",
    "test:standalone": "node --import tsx scripts/standalone-check.ts",
    "eval:compare": "node --import tsx scripts/compare-evals.ts",
    "eval:pilot": "node --import tsx scripts/summarize-efficiency-pilot.ts",
    "eval:correction-replay": "node --import tsx scripts/replay-correction-evidence.ts",
    "format": "prettier --write \"server/*.ts\" \"server/adapters/*.ts\" \"src/*.{tsx,css}\" \"scripts/*.ts\" \"tests/*.ts\" \"evals/*.ts\"",
    "source:export": "node --import tsx scripts/export-source.ts",
    "security:secrets": "node scripts/check-secrets.mjs",
    "distribution:sign": "node --import tsx scripts/distribute-macos.ts sign",
    "distribution:submit": "node --import tsx scripts/distribute-macos.ts submit",
    "distribution:status": "node --import tsx scripts/distribute-macos.ts status",
    "distribution:finalize": "node --import tsx scripts/distribute-macos.ts finalize"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sandbox-runtime": "0.0.76",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@formulajs/formulajs": "4.6.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.155.0",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "marked": "18.0.13",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx-calc": "0.9.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.38.1",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
