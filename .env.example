# Optional for source runs. The app does not auto-load .env files.
# Export these variables, or copy to .env and run:
# node --env-file=.env --import tsx server/index.ts
# Prefer the local Keychain connection form on macOS. Never commit real keys.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
PORT=4318
# Omit ROUTER_DATA_DIR to use .router in the source checkout.
# ROUTER_DATA_DIR=/absolute/private/path/outside/your/task/projects
# Optional package output directory; defaults to a private temporary directory.
# DUKE_PACKAGE_DIR=/absolute/path/to/local/build-output
# The iPhone gateway is disabled unless this is explicitly exported as 1.
# DUKE_REMOTE_ENABLE=1
# DUKE_REMOTE_PORT=4319
# Tailscale identity is required by default. Set 0 only for another reviewed
# private HTTPS transport.
# DUKE_REMOTE_REQUIRE_TAILSCALE=1
